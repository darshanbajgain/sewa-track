# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://sewa:sewa_dev_password@localhost:5432/sewa_track
TEST_DATABASE_URL=postgres://sewa:sewa_dev_password@localhost:5432/sewa_track_test
LOG_LEVEL=info
# Login token signing secret: at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
SESSION_HOURS=8
# Swagger UI at /api/docs (true/false)
API_DOCS_ENABLED=true
# Number of proxies in front of the API (0 locally; docker compose: 1 = the web app's /api rewrite)
TRUST_PROXY=0
# Deployed only: the same random value (32+ chars) on the API and the web app. The web app sends it on
# every /api request; the API then refuses anyone else (except /live and /health). Leave unset locally.
# PROXY_SECRET=
# The mock National ID service (PRD F9). `pnpm dev` starts it on port 4100. Unset = no identity checks.
NID_BASE_URL=http://localhost:4100
# The private system admin, created/updated by `pnpm db:seed` and `pnpm demo:reset` (not in the repo).
# Email must end in @example.com (demo rule); password at least 12 characters. Leave unset to skip.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
