{
  "name": "sewa-track",
  "private": true,
  "description": "Demo / portfolio citizen-service request tracker for Nepal. Not affiliated with any government body.",
  "license": "MIT",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm build:shared && pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @sewa/shared build",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "test": "pnpm build:shared && pnpm -r test",
    "db:migrate": "pnpm --filter @sewa/api db:migrate",
    "db:seed": "pnpm --filter @sewa/api db:seed"
  }
}
